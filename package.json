{
	"name": "pcf-project",
	"version": "1.0.0",
	"description": "Project containing your PowerApps Component Framework (PCF) control.",
	"scripts": {
		"build": "pcf-scripts build",
		"clean": "pcf-scripts clean",
		"dev:watch": "node scripts/dev-loop-watch.js",
		"lint": "eslint CMModelDrivenGrid --ext .ts,.tsx",
		"lint:fix": "eslint CMModelDrivenGrid --ext .ts,.tsx --fix",
		"rebuild": "pcf-scripts rebuild",
		"start": "pcf-scripts start",
		"start:watch": "pcf-scripts start watch",
		"demo": "node scripts/start-demo.js",
		"test:local": "npm run test:core && npm run test:inline-edit && npm run test:cell-selection && npm run test:grid && npm run test:filters && npm run test:children && npm run test:demo-hierarchy && npm run test:r200s-demo && npm run test:dev-tools",
		"test:r200s-demo": "tsx scripts/local-r200s-demo-test.ts",
		"test:demo-hierarchy": "tsx scripts/local-demo-hierarchy-test.ts",
		"test:children": "tsx scripts/local-child-records-test.ts && tsx scripts/local-native-hierarchy-test.ts",
		"test:filters": "tsx scripts/local-filter-semantics-test.ts && tsx scripts/local-demo-filter-test.ts && tsx scripts/local-filter-editor-test.tsx",
		"test:core": "tsx scripts/local-core-logic-test.ts && tsx scripts/local-parity-logic-test.ts && tsx scripts/local-column-editability-test.ts",
		"test:inline-edit": "tsx scripts/local-inline-edit-test.tsx",
		"test:cell-selection": "tsx scripts/local-cell-selection-test.tsx",
		"test:grid": "tsx scripts/local-grid-regression-test.tsx",
		"test:dev-tools": "node scripts/local-dev-tools-test.js",
		"refreshTypes": "pcf-scripts refreshTypes",
		"push:dev": "pac pcf push --environment https://capricorndevelopment.crm4.dynamics.com/ --publisher-prefix cm --incremental",
		"dev:loop": "npm run test:local && npm run build"
	},
	"dependencies": {
		"@fluentui/react": "^8.121.3",
		"react": "^16.14.0",
		"react-dom": "^16.14.0"
	},
	"devDependencies": {
		"@microsoft/eslint-plugin-power-apps": "^0.2.51",
		"@types/node": "^18.19.55",
		"@types/powerapps-component-framework": "^1.3.15",
		"@types/react": "^16.14.62",
		"@types/react-dom": "^16.9.25",
		"eslint": "^9.17.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.1.0",
		"jsdom": "^28.1.0",
		"pcf-scripts": "^1",
		"pcf-start": "^1",
		"tsx": "^4.21.0",
		"typescript": "^4.9.5",
		"typescript-eslint": "^8.18.1"
	},
	"overrides": {
		"@types/react": "^16.14.62",
		"@types/react-dom": "^16.9.25",
		"react": "^16.14.0",
		"react-dom": "^16.14.0"
	}
}
